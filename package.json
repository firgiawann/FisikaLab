{
  "name": "fisika-xi-multimedia-mdlc",
  "private": true,
  "version": "2.0.0",
  "description": "Platform Multimedia Pembelajaran Interaktif Fisika Kelas XI Berbasis MDLC & 12 Prinsip Mayer (React + Framer Motion + Canvas Physics 2D + Express + SQLite)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "client": "vite --port 5173",
    "server": "node --no-warnings server.js",
    "build": "vite build",
    "start": "node --no-warnings server.js",
    "test": "node --no-warnings --test tests/api.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
